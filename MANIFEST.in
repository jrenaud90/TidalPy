# MANIFEST.in

# Exclude all c++ and c files. Every one in the tree is generated by Cython, so the sdist is cythonized locally.
exclude **/*.c
exclude **/*.cpp

# Include data files used for plotting and benchmarking
include TidalPy/Utilities/graphics/data/*.csv

# Include the bundled example world and system configurations (WorldPack) and their companion data files (e.g.
# PREM-like radial profiles).
include TidalPy/WorldPack/*.toml
include TidalPy/WorldPack/*.csv

# Include Cython pyx and pxd files
global-include *.pxd
global-include *.pyx
include cython_extensions.json

# Include the C++ headers
global-include *.hpp
global-include *.h

# Include the header-only submodules a source build compiles against
recursive-include Dependencies/xsf/include/xsf *.h
recursive-include Dependencies/eigen/Eigen *
recursive-include Dependencies/eigen/unsupported *
recursive-include Dependencies/spdlog/include *

# Exclude the tests, documentation, notebooks, and editor folders
prune .vscode
prune .idea
prune .github
prune Tests
prune Papers
prune Demos
prune Documentation
prune Benchmarks
